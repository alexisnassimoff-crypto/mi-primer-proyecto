# Copiar a `.env` y completar. NUNCA commitear `.env` (ya esta en .gitignore).

# Modo: 1 = simulado (default, sin gastar creditos) · 0 = real
DRY_RUN=1

# --- APIs (modo real) ---
SUNO_API_KEY=
ATLABS_API_KEY=
VOICE_API_KEY=            # opcional (LOVO/Genny o ElevenLabs)

# --- YouTube (OAuth) ---
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# --- Endpoints (ajustar segun la doc de cada proveedor) ---
SUNO_BASE_URL=https://api.suno.ai/v1
ATLABS_BASE_URL=https://api.atlabs.ai/v1
VOICE_BASE_URL=https://api.elevenlabs.io/v1
